FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY global.json Directory.Build.props ./
COPY src/CourtConnect.Ui.Components/CourtConnect.Ui.Components.csproj src/CourtConnect.Ui.Components/
COPY src/CourtConnect.Ui.Web/CourtConnect.Ui.Web.csproj src/CourtConnect.Ui.Web/
RUN dotnet restore src/CourtConnect.Ui.Web/CourtConnect.Ui.Web.csproj

COPY . .
RUN dotnet publish src/CourtConnect.Ui.Web/CourtConnect.Ui.Web.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
USER $APP_UID

ENTRYPOINT ["dotnet", "DeemSoft.CourtConnect.Ui.Web.dll"]
