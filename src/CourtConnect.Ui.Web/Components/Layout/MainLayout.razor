@inherits LayoutComponentBase

<nav class="site-nav" aria-label="Navegación principal">
    <a class="site-brand" href="/games">
        <span class="site-brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="8.5" />
                <path d="M3.5 12h17M12 3.5v17" />
            </svg>
        </span>
        CourtConnect
    </a>
    <AuthorizeView>
        <Authorized>
            <AuthorizeView Roles="Organizer">
                <Authorized Context="organizerContext">
                    <NavLink class="site-nav-link" href="/organizer">Panel organizador</NavLink>
                    <NavLink class="site-nav-link" href="/organizer/courts">Pistas</NavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="Player">
                <Authorized Context="playerContext">
                    <NavLink class="site-nav-link" href="/inscripciones">Inscripciones</NavLink>
                </Authorized>
            </AuthorizeView>
            <NavLink class="site-nav-link" href="/profile">Mi perfil</NavLink>
            <a class="site-nav-logout" href="/logout">Cerrar sesión</a>
        </Authorized>
        <NotAuthorized>
            <NavLink class="site-nav-link" href="/login">Iniciar sesión</NavLink>
            <NavLink class="site-nav-register" href="/register">Crear cuenta</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@Body
