@page "/games/{Id:guid}/register"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ICourtConnectApiClient ApiClient

<PageTitle>Apuntarse al partido</PageTitle>

<main class="page page--wide">
    <p><a href="@($"/games/{Id}")">← Volver a la ficha del partido</a></p>
    <h1>Apuntarse al partido</h1>

    @if (_errorMessage is not null)
    {
        <p class="message message-error" role="alert">@_errorMessage</p>
    }
    else if (_game is not null)
    {
        @if (_successMessage is not null)
        {
            <p class="message message-success" role="status">@_successMessage</p>
        }
        else if (_game.AvailableSlots == 0 || _game.Status != "Open")
        {
            <p class="message message-info">Este partido ya no admite inscripciones.</p>
        }
        else
        {
            <section class="game-detail registration-confirmation">
                <div class="game-date" aria-label="@_game.StartAt.ToLocalTime().ToString("D", SpanishCulture)">
                    <span>@_game.StartAt.ToLocalTime().ToString("MMM", SpanishCulture).TrimEnd('.').ToUpper(SpanishCulture)</span>
                    <strong>@_game.StartAt.ToLocalTime().Day</strong>
                </div>
                <div class="registration-confirmation-info">
                    <h2>@_game.CourtName</h2>
                    <p>@_game.StartAt.ToLocalTime().ToString("f", SpanishCulture)</p>
                    <EditForm class="form-actions" Model="FormModel!" OnValidSubmit="RegisterAsync" FormName="RegisterForGame" Enhance>
                        <button class="button" type="submit">Confirmar inscripción</button>
                        <a class="button button-outline" href="@($"/games/{Id}")">Cancelar</a>
                    </EditForm>
                </div>
            </section>
        }
    }
</main>

@code {
    private const string FormName = "RegisterForGame";
    private static readonly System.Globalization.CultureInfo SpanishCulture =
        System.Globalization.CultureInfo.GetCultureInfo("es-ES");

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = FormName)]
    private RegistrationForm? FormModel { get; set; }

    private GameDto? _game;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnParametersSetAsync()
    {
        _errorMessage = null;
        FormModel ??= new RegistrationForm();
        try
        {
            _game = await ApiClient.GetGameAsync(Id, CancellationToken.None);
        }
        catch (CourtConnectApiException exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private async Task RegisterAsync()
    {
        _errorMessage = null;
        try
        {
            await ApiClient.RegisterAsync(Id, CancellationToken.None);
            _successMessage = "Tu inscripción se ha confirmado.";
        }
        catch (CourtConnectApiException exception)
        {
            _errorMessage = exception.Message;
        }
    }
    private sealed class RegistrationForm
    {
    }
}
