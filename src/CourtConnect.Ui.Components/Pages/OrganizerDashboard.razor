@page "/organizer"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Organizer")]
@inject ICourtConnectApiClient ApiClient

<PageTitle>Panel del organizador</PageTitle>

<main class="page">
    <header class="page-header">
        <p class="eyebrow">Organizador</p>
        <h1>Gestiona tus partidos</h1>
        <p>Crea partidos y administra solo los que pertenecen a tu cuenta.</p>
    </header>

    @if (_errorMessage is not null)
    {
        <p class="message message-error" role="alert">@_errorMessage</p>
    }
    @if (_successMessage is not null)
    {
        <p class="message message-success" role="status">@_successMessage</p>
    }

    <section class="game-detail">
        <h2>Crear partido</h2>
        @if (_courts is null)
        {
            <p role="status">Cargando pistas…</p>
        }
        else if (_courts.Count == 0)
        {
            <p class="message message-info">No hay pistas disponibles para crear un partido.</p>
        }
        else
        {
            <EditForm Model="CreateForm!" OnValidSubmit="CreateGameAsync" FormName="@CreateFormName" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary />
                <label for="create-court">Pista</label>
                <InputSelect id="create-court" class="form-control" @bind-Value="CreateForm!.CourtId">
                    <option value="">Selecciona una pista</option>
                    @foreach (var court in _courts)
                    {
                        <option value="@court.Id">@court.Name — @court.Location</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => CreateForm!.CourtId)" />
                <label for="create-start">Fecha y hora</label>
                <InputDate id="create-start" class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="CreateForm!.StartAt" />
                <ValidationMessage For="@(() => CreateForm!.StartAt)" />
                <label for="create-duration">Duración (minutos)</label>
                <InputNumber id="create-duration" class="form-control" @bind-Value="CreateForm!.DurationMinutes" />
                <ValidationMessage For="@(() => CreateForm!.DurationMinutes)" />
                <label for="create-capacity">Plazas</label>
                <InputNumber id="create-capacity" class="form-control" @bind-Value="CreateForm!.Capacity" />
                <ValidationMessage For="@(() => CreateForm!.Capacity)" />
                <label for="create-age">Edad mínima</label>
                <InputNumber id="create-age" class="form-control" @bind-Value="CreateForm!.MinimumAge" />
                <ValidationMessage For="@(() => CreateForm!.MinimumAge)" />
                <label for="create-price">Precio por jugador</label>
                <InputNumber id="create-price" class="form-control" @bind-Value="CreateForm!.PricePerPlayer" />
                <ValidationMessage For="@(() => CreateForm!.PricePerPlayer)" />
                <button class="button" type="submit">Crear partido</button>
            </EditForm>
        }
    </section>

    <section>
        <h2>Tus partidos</h2>
        @if (_games is null)
        {
            <p role="status">Cargando tus partidos…</p>
        }
        else if (_games.Count == 0)
        {
            <p class="empty-state">Todavía no has creado ningún partido.</p>
        }
        else
        {
            @* En SSR estático, cada botón envía un comando junto con el identificador del partido. *@
            <EditForm Model="ManagementForm!" OnValidSubmit="HandleManagementCommandAsync" FormName="@ManagementFormName" Enhance>
                <div class="game-list">
                @foreach (var game in _games)
                {
                    <article class="game-detail" @key="game.Id">
                        <h3>@game.CourtName</h3>
                        <p>@game.StartAt.ToLocalTime().ToString("f", SpanishCulture)</p>
                        <p>@game.AvailableSlots de @game.Capacity plazas libres · Estado: @GetStatusDisplayName(game.Status)</p>
                        <button class="button button-secondary" type="submit" name="ManagementForm.Command" value="@($"edit:{game.Id}")">Editar</button>
                        <button class="button" type="submit" name="ManagementForm.Command" value="@($"status:{game.Id}")">
                            @(game.Status == "Open" ? "Cerrar partido" : "Abrir partido")
                        </button>
                    </article>
                }
                </div>
            </EditForm>
        }
    </section>

    @if (_editingGameId is not null && EditForm is not null)
    {
        <section class="game-detail">
            <h2>Editar partido</h2>
            <EditForm Model="EditForm" OnValidSubmit="SaveEditAsync" FormName="@EditFormName" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary />
                <input type="hidden" name="EditForm.GameId" value="@EditForm.GameId" />
                <input type="hidden" name="EditForm.CourtId" value="@EditForm.CourtId" />
                <label for="edit-start">Fecha y hora</label>
                <InputDate id="edit-start" class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="EditForm.StartAt" />
                <ValidationMessage For="@(() => EditForm.StartAt)" />
                <label for="edit-duration">Duración (minutos)</label>
                <InputNumber id="edit-duration" class="form-control" @bind-Value="EditForm.DurationMinutes" />
                <ValidationMessage For="@(() => EditForm.DurationMinutes)" />
                <label for="edit-capacity">Plazas</label>
                <InputNumber id="edit-capacity" class="form-control" @bind-Value="EditForm.Capacity" />
                <ValidationMessage For="@(() => EditForm.Capacity)" />
                <label for="edit-age">Edad mínima</label>
                <InputNumber id="edit-age" class="form-control" @bind-Value="EditForm.MinimumAge" />
                <ValidationMessage For="@(() => EditForm.MinimumAge)" />
                <label for="edit-price">Precio por jugador</label>
                <InputNumber id="edit-price" class="form-control" @bind-Value="EditForm.PricePerPlayer" />
                <ValidationMessage For="@(() => EditForm.PricePerPlayer)" />
                <button class="button" type="submit">Guardar cambios</button>
                <a class="button button-secondary" href="/organizer">Cancelar</a>
            </EditForm>
        </section>
    }
</main>

@code {
    private const string CreateFormName = "CreateOrganizerGame";
    private const string ManagementFormName = "ManageOrganizerGames";
    private const string EditFormName = "EditOrganizerGame";
    private static readonly System.Globalization.CultureInfo SpanishCulture =
        System.Globalization.CultureInfo.GetCultureInfo("es-ES");
    private static string GetStatusDisplayName(string status) => status switch
    {
        "Open" => "Abierto",
        "Closed" => "Cerrado",
        "Draft" => "Borrador",
        _ => "Desconocido"
    };

    [SupplyParameterFromForm(FormName = CreateFormName)]
    private GameForm? CreateForm { get; set; }

    [SupplyParameterFromForm(FormName = ManagementFormName)]
    private GameCommandForm? ManagementForm { get; set; }

    [SupplyParameterFromForm(FormName = EditFormName)]
    private GameForm? EditForm { get; set; }

    private IReadOnlyList<CourtDto>? _courts;
    private IReadOnlyList<GameDto>? _games;
    private Guid? _editingGameId;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        CreateForm ??= new GameForm();
        ManagementForm ??= new GameCommandForm();
        if (EditForm is not null && Guid.TryParse(EditForm.GameId, out var gameId))
        {
            _editingGameId = gameId;
        }

        await LoadAsync();
    }

    private async Task CreateGameAsync()
    {
        _errorMessage = null;
        _successMessage = null;
        try
        {
            var form = CreateForm
                ?? throw new InvalidOperationException("The create-game form is unavailable.");
            await ApiClient.CreateGameAsync(
                new CreateGameRequestDto(
                    Guid.TryParse(form.CourtId, out var courtId)
                        ? courtId
                        : throw new InvalidOperationException("The selected court is invalid."),
                    ToDateTimeOffset(form.StartAt),
                    form.DurationMinutes,
                    form.Capacity,
                    form.MinimumAge,
                    form.PricePerPlayer),
                CancellationToken.None);
            CreateForm = new GameForm();
            await LoadGamesAsync();
            _successMessage = "El partido se ha creado correctamente.";
        }
        catch (CourtConnectApiException exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private async Task HandleManagementCommandAsync()
    {
        _errorMessage = null;
        _successMessage = null;
        var submittedCommand = ManagementForm?.Command;
        if (string.IsNullOrWhiteSpace(submittedCommand))
        {
            _errorMessage = "La acción solicitada no es válida.";
            return;
        }

        var command = submittedCommand.Split(':', 2);
        if (command.Length != 2 || !Guid.TryParse(command[1], out var gameId))
        {
            _errorMessage = "La acción solicitada no es válida.";
            return;
        }

        var game = _games?.SingleOrDefault(item => item.Id == gameId);
        if (game is null)
        {
            _errorMessage = "No se encontró el partido que quieres gestionar.";
            return;
        }

        if (command[0] == "edit")
        {
            BeginEdit(game);
            return;
        }

        if (command[0] == "status")
        {
            await ToggleStatusAsync(game);
            return;
        }

        _errorMessage = "La acción solicitada no es válida.";
    }

    private void BeginEdit(GameDto game)
    {
        _editingGameId = game.Id;
        EditForm = GameForm.FromGame(game);
        _errorMessage = null;
        _successMessage = null;
    }

    private async Task SaveEditAsync()
    {
        _errorMessage = null;
        _successMessage = null;
        try
        {
            var form = EditForm
                ?? throw new InvalidOperationException("The edit-game form is unavailable.");
            var gameId = Guid.TryParse(form.GameId, out var parsedGameId)
                ? parsedGameId
                : throw new InvalidOperationException("The game selected for editing is invalid.");
            await ApiClient.UpdateGameAsync(
                gameId,
                new UpdateGameRequestDto(
                    ToDateTimeOffset(form.StartAt),
                    form.DurationMinutes,
                    form.Capacity,
                    form.MinimumAge,
                    form.PricePerPlayer),
                CancellationToken.None);
            _editingGameId = null;
            EditForm = null;
            await LoadGamesAsync();
            _successMessage = "Los cambios se han guardado.";
        }
        catch (CourtConnectApiException exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private async Task ToggleStatusAsync(GameDto game)
    {
        _errorMessage = null;
        _successMessage = null;
        try
        {
            var nextStatus = game.Status == "Open" ? "Closed" : "Open";
            await ApiClient.SetGameStatusAsync(game.Id, nextStatus, CancellationToken.None);
            await LoadGamesAsync();
            _successMessage = nextStatus == "Open" ? "El partido está abierto." : "El partido se ha cerrado.";
        }
        catch (CourtConnectApiException exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private async Task LoadAsync()
    {
        _errorMessage = null;
        try
        {
            _courts = await ApiClient.GetCourtsAsync(CancellationToken.None);
            await LoadGamesAsync();
        }
        catch (CourtConnectApiException exception)
        {
            _courts = [];
            _games = [];
            _errorMessage = exception.Message;
        }
    }

    private async Task LoadGamesAsync()
    {
        _games = await ApiClient.GetMyOrganizedGamesAsync(CancellationToken.None);
    }

    private static DateTimeOffset ToDateTimeOffset(DateTime? dateTime)
    {
        if (dateTime is null)
        {
            throw new InvalidOperationException("The game date and time are required.");
        }

        return new DateTimeOffset(dateTime.Value);
    }

    private sealed class GameForm
    {
        public GameForm()
        {
            StartAt = DateTime.Now.AddDays(1);
        }

        public static GameForm FromGame(GameDto game)
        {
            return new GameForm
            {
                GameId = game.Id.ToString(),
                CourtId = game.CourtId.ToString(),
                StartAt = game.StartAt.LocalDateTime,
                DurationMinutes = game.DurationMinutes,
                Capacity = game.Capacity,
                MinimumAge = game.MinimumAge,
                PricePerPlayer = game.PricePerPlayer
            };
        }

        public string GameId { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Selecciona una pista.")]
        public string CourtId { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Indica la fecha y hora.")]
        public DateTime? StartAt { get; set; }

        [System.ComponentModel.DataAnnotations.Range(1, 1440, ErrorMessage = "La duración debe estar entre 1 y 1440 minutos.")]
        public int DurationMinutes { get; set; } = 90;

        [System.ComponentModel.DataAnnotations.Range(2, 1000, ErrorMessage = "Las plazas deben estar entre 2 y 1000.")]
        public int Capacity { get; set; } = 4;

        [System.ComponentModel.DataAnnotations.Range(16, 120, ErrorMessage = "La edad mínima debe estar entre 16 y 120 años.")]
        public int MinimumAge { get; set; } = 16;

        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0", "1000000", ErrorMessage = "El precio no puede ser negativo.")]
        public decimal PricePerPlayer { get; set; } = 10m;
    }

    private sealed class GameCommandForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Command { get; set; } = string.Empty;
    }
}
