@page "/profile"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ICourtConnectApiClient ApiClient
@inject IWebAuthenticationService AuthenticationService

<PageTitle>Mi perfil</PageTitle>

<main class="page page--wide">
    <header class="page-header">
        <h1>Mi perfil</h1>
    </header>

    @if (_errorMessage is not null)
    {
        <p class="message message-error" role="alert">@_errorMessage</p>
    }
    else if (_account is not null)
    {
        <section class="game-detail profile-card">
            <h2>Datos de la cuenta</h2>
            <dl class="profile-data">
                <div>
                    <dt>Correo electrónico</dt>
                    <dd>@(_account.Email ?? "No indicado")</dd>
                </div>
            </dl>
            <div class="profile-account-roles">
                <strong class="profile-role-label">Roles</strong>
                <div class="profile-roles">
                    @if (_account.Roles.Count == 0)
                    {
                        <span>Sin roles asignados</span>
                    }
                    else
                    {
                        @foreach (var role in _account.Roles)
                        {
                            <span class="role-badge">@GetRoleDisplayName(role)</span>
                        }
                    }
                </div>
            </div>
        </section>

        @if (_player is not null)
        {
            <section class="game-detail profile-card">
                <h2>Datos de jugador</h2>
                <dl class="profile-data">
                    <div>
                        <dt>Nombre de usuario</dt>
                        <dd>@_player.Nickname</dd>
                    </div>
                    <div>
                        <dt>Nombre completo</dt>
                        <dd>@_player.FullName</dd>
                    </div>
                    <div>
                        <dt>Fecha de nacimiento</dt>
                        <dd>@_player.DateOfBirth.ToString("dd/MM/yyyy", SpanishCulture)</dd>
                    </div>
                    <div>
                        <dt>Correo electrónico</dt>
                        <dd>@_player.Email</dd>
                    </div>
                </dl>
            </section>
            <p class="message message-success" role="status">Tu perfil de jugador ya está completo.</p>
            <p><a class="button button-outline" href="/games">Ver partidos</a></p>
        }
        else
        {
            <p>Todavía no tienes un perfil de jugador. Completa estos datos para gestionar tus inscripciones.</p>
            <EditForm Model="FormModel!" OnValidSubmit="SaveProfileAsync" FormName="PlayerProfile" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary />
                <label for="nickname">Nombre de usuario</label>
                <InputText id="nickname" class="form-control" autocomplete="nickname" @bind-Value="FormModel!.Nickname" />
                <ValidationMessage For="@(() => FormModel!.Nickname)" />
                <label for="full-name">Nombre completo</label>
                <InputText id="full-name" class="form-control" autocomplete="name" @bind-Value="FormModel!.FullName" />
                <ValidationMessage For="@(() => FormModel!.FullName)" />
                <label for="date-of-birth">Fecha de nacimiento</label>
                <InputDate id="date-of-birth" class="form-control" @bind-Value="FormModel!.DateOfBirth" />
                <ValidationMessage For="@(() => FormModel!.DateOfBirth)" />
                <button class="button" type="submit">Guardar perfil</button>
            </EditForm>
        }
    }
</main>

@code {
    private const string FormName = "PlayerProfile";

    [SupplyParameterFromForm(FormName = FormName)]
    private ProfileForm? FormModel { get; set; }

    private static readonly System.Globalization.CultureInfo SpanishCulture =
        System.Globalization.CultureInfo.GetCultureInfo("es-ES");

    private CurrentAccountDto? _account;
    private PlayerDto? _player;
    private string? _errorMessage;
    protected override async Task OnInitializedAsync()
    {
        FormModel ??= new ProfileForm();
        try
        {
            _account = await ApiClient.GetMyAccountAsync(CancellationToken.None);
        }
        catch (CourtConnectApiException exception)
        {
            _errorMessage = exception.Message;
            return;
        }

        try
        {
            // Una cuenta de Identity puede existir antes de que su propietario cree la ficha de jugador.
            _player = await ApiClient.GetMyProfileAsync(CancellationToken.None);
        }
        catch (CourtConnectApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            // El 404 de /players/me indica que aún falta crear la ficha, no que falte la cuenta.
        }
        catch (CourtConnectApiException exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private async Task SaveProfileAsync()
    {
        _errorMessage = null;
        try
        {
            _player = await ApiClient.CreateMyProfileAsync(
                new CreatePlayerProfileRequest(
                    FormModel!.Nickname,
                    FormModel.FullName,
                    FormModel.DateOfBirth
                        ?? throw new InvalidOperationException("La fecha de nacimiento es obligatoria.")),
                CancellationToken.None);
            await AuthenticationService.RefreshAsync(CancellationToken.None);
            // Crear la ficha también asigna el rol Player, por eso se vuelve a consultar la cuenta actualizada.
            _account = await ApiClient.GetMyAccountAsync(CancellationToken.None);
        }
        catch (CourtConnectApiException exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private static string GetRoleDisplayName(string role) => role switch
    {
        "Organizer" => "Organizador",
        "Player" => "Jugador",
        _ => "Otro"
    };

    private sealed class ProfileForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Introduce un nombre de usuario.")]
        [System.ComponentModel.DataAnnotations.StringLength(50)]
        public string Nickname { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Introduce tu nombre completo.")]
        [System.ComponentModel.DataAnnotations.StringLength(150)]
        public string FullName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Introduce tu fecha de nacimiento.")]
        public DateOnly? DateOfBirth { get; set; }
    }
}
