@apiHost = http://localhost:5258
@playerEmail = player-{{$guid}}@example.com
@playerNickname = player-{{$guid}}
@developmentPassword = <set-a-local-password-in-user-secrets>
@organizerEmail = organizer@example.com

### Registrar cuenta de jugador
POST {{apiHost}}/auth/register
Content-Type: application/json

{
  "email": "{{playerEmail}}",
  "password": "{{developmentPassword}}"
}

### Iniciar sesión como jugador
# @name playerLogin
POST {{apiHost}}/auth/login?useCookies=false
Content-Type: application/json

{
  "email": "{{playerEmail}}",
  "password": "{{developmentPassword}}"
}

###
@playerToken = {{playerLogin.response.body.accessToken}}

### Crear el perfil del jugador autenticado
POST {{apiHost}}/players/me
Authorization: Bearer {{playerToken}}
Content-Type: application/json

{
  "nickname": "{{playerNickname}}",
  "fullName": "Jugador de Prueba",
  "dateOfBirth": "2000-01-01"
}

### Consultar mi perfil
GET {{apiHost}}/players/me
Authorization: Bearer {{playerToken}}
Accept: application/json

### Listar partidos abiertos y futuros (público)
GET {{apiHost}}/games
Accept: application/json

### Ver partido existente (público)
GET {{apiHost}}/games/33333333-3333-3333-3333-333333333333
Accept: application/json

### Partido inexistente (404)
GET {{apiHost}}/games/00000000-0000-0000-0000-000000000001
Accept: application/json

### Iniciar sesión como organizador semilla
# @name organizerLogin
POST {{apiHost}}/auth/login?useCookies=false
Content-Type: application/json

{
  "email": "{{organizerEmail}}",
  "password": "{{developmentPassword}}"
}

###
@organizerToken = {{organizerLogin.response.body.accessToken}}

### Crear cancha sin autenticación (401)
POST {{apiHost}}/courts
Content-Type: application/json

{
  "name": "Cancha de pruebas",
  "location": "Barcelona"
}

### Crear cancha como organizador (201)
# @name createCourt
POST {{apiHost}}/courts
Authorization: Bearer {{organizerToken}}
Content-Type: application/json

{
  "name": "Cancha de pruebas",
  "location": "Barcelona"
}

###
@courtId = {{createCourt.response.body.$.id}}

### Actualizar pista como organizador
PUT {{apiHost}}/courts/{{courtId}}
Authorization: Bearer {{organizerToken}}
Content-Type: application/json

{
  "name": "Cancha central",
  "location": "Barcelona"
}

### Crear partido como organizador (201)
# @name createGame
POST {{apiHost}}/games
Authorization: Bearer {{organizerToken}}
Content-Type: application/json

{
  "courtId": "{{courtId}}",
  "startAt": "2030-02-01T18:00:00+01:00",
  "durationMinutes": 90,
  "capacity": 4,
  "minimumAge": 16,
  "pricePerPlayer": 10
}

###
@gameId = {{createGame.response.body.$.id}}

### Modificar partido (solo su organizador)
PUT {{apiHost}}/games/{{gameId}}
Authorization: Bearer {{organizerToken}}
Content-Type: application/json

{
  "startAt": "2030-02-02T18:00:00+01:00",
  "durationMinutes": 120,
  "capacity": 6,
  "minimumAge": 18,
  "pricePerPlayer": 12
}

### Inscribir al jugador autenticado (no se envía playerId)
# @name createRegistration
POST {{apiHost}}/games/{{gameId}}/registrations
Authorization: Bearer {{playerToken}}

###
@registrationId = {{createRegistration.response.body.$.id}}

### Ver inscripciones (autenticado)
GET {{apiHost}}/games/{{gameId}}/registrations
Authorization: Bearer {{playerToken}}
Accept: application/json

### Cancelar mi inscripción (204, solo con más de 72 horas de antelación)
POST {{apiHost}}/registrations/{{registrationId}}/cancel
Authorization: Bearer {{playerToken}}

### Cancelar inscripción inexistente o ajena (404)
POST {{apiHost}}/registrations/00000000-0000-0000-0000-000000000001/cancel
Authorization: Bearer {{playerToken}}

### Cerrar partido (solo su organizador)
PUT {{apiHost}}/games/{{gameId}}/status
Authorization: Bearer {{organizerToken}}
Content-Type: application/json

{
  "status": "Closed"
}

### Volver a abrir partido (solo su organizador)
PUT {{apiHost}}/games/{{gameId}}/status
Authorization: Bearer {{organizerToken}}
Content-Type: application/json

{
  "status": "Open"
}

### Crear una pista sin partidos para probar su eliminación
# @name createCourtToDelete
POST {{apiHost}}/courts
Authorization: Bearer {{organizerToken}}
Content-Type: application/json

{
  "name": "Pista temporal",
  "location": "Barcelona"
}

###
@courtToDeleteId = {{createCourtToDelete.response.body.$.id}}

### Eliminar pista sin partidos (204)
DELETE {{apiHost}}/courts/{{courtToDeleteId}}
Authorization: Bearer {{organizerToken}}

### Intentar eliminar una pista con un partido asociado (409)
DELETE {{apiHost}}/courts/{{courtId}}
Authorization: Bearer {{organizerToken}}
